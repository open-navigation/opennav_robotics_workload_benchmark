flash_device() {
  set -e
  unset LC_ALL
  echo sleep 30 seconds to make sure Jetson board is connected back after pre check.
  sleep 30
  FlashOptions=$(echo " --nv-auto-config --username opennav" | sed s/mmcblk1p1/mmcblk0p1/)
  echo sudo ./nvsdkmanager_flash.sh $FlashOptions
  sudo ./nvsdkmanager_flash.sh $FlashOptions
  echo waiting for device boot up...
  sleep 30
  if [[ ' --nv-auto-config --username opennav' == *'--nv-auto-config'* ]]; then
    echo waiting for device auto config process...
    sleep 120
  fi
  echo done.
}
collect_uart_logs flash_device $EXTRA_LOG_FILE
