<?xml version="1.0"?>
<package format="3">
  <name>opennav_benchmark_vlm</name>
  <version>0.1.0</version>
  <description>ROS 2 node exposing a locally-served vision-language model as bool/int/string action servers.</description>
  <maintainer email="steve@opennav.org">Steve Macenski</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>opennav_benchmark_vlm_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
