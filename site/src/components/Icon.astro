  power: '<path d="M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12z"/>',
  thermal: '<path d="M14 14.8V4a2 2 0 1 0-4 0v10.8a4.5 4.5 0 1 0 4 0z"/><path d="M12 10v6"/>',
