---
/**
 * Inline icon set.
 *
 * One consistent family: 24x24 viewBox, 1.6 stroke, round caps and joins,
 * drawn in `currentColor` so an icon always inherits the ink of the text it
 * sits beside. Icons are decorative by default. Every one is paired with a
 * visible label, so they carry no information on their own.
 */
export type IconName =
  | 'cpu'
  | 'gpu'
  | 'memory'
  | 'power'
  | 'thermal'
  | 'robot'
  | 'ai'
  | 'gauge'
  | 'layers'
  | 'check'
  | 'alert'
  | 'arrow-right'
  | 'download'
  | 'github'
  | 'mail'
  | 'book'
  | 'chart'
  | 'shield'
  | 'external'
  | 'play'
  | 'terminal'
  | 'scale'
  | 'building'
  | 'sensor'
  | 'network'
  | 'radar'
  | 'plus';

export interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

const paths: Record<string, string> = {
