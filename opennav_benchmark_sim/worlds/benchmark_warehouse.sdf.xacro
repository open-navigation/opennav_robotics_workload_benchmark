    <xacro:support_column name="int_41" x="40" y="-23"/>
    <xacro:support_column name="int_42" x="40" y="15"/>

    <!-- ============================================================ -->
    <!-- ZONE A: BULK STORAGE (big shelves, back-to-back pairs, 2.0 m aisles) -->
    <!-- 14 rows x 12 per row, aisle ~2.0m -->
    <!-- ============================================================ -->

