<?xml version="1.0"?>
<sdf version="1.7" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="headless" default="false"/>

  <world name="benchmark_warehouse">

    <!-- Physics -->
    <physics name="5ms" type="bullet">
      <max_step_size>0.005</max_step_size>
      <real_time_update_rate>500.0</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <xacro:unless value="$(arg headless)">
      <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    </xacro:unless>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Scene -->
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
    </scene>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.001</linear>
        <quadratic>0.0001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <!-- Ground plane (120m x 140m) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>120 140</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>120 140</size></plane></geometry>
          <material>
            <ambient>0.55 0.55 0.53 1</ambient>
            <diffuse>0.55 0.55 0.53 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>


    <!-- ============================================================ -->
    <!-- MACROS                                                        -->
    <!-- ============================================================ -->

    <!-- Brick perimeter wall (10.0m tall, two-tone red brick) -->
    <xacro:macro name="wall_segment" params="name x y yaw length">
      <model name="wall_${name}">
        <static>true</static>
        <pose>${x} ${y} 0 0 0 ${yaw}</pose>
        <link name="link">
          <visual name="lower">
            <pose>0 0 1.25 0 0 0</pose>
            <geometry><box><size>${length} 0.3 2.5</size></box></geometry>
            <material>
              <ambient>0.50 0.18 0.08 1</ambient>
              <diffuse>0.50 0.18 0.08 1</diffuse>
              <specular>0.05 0.05 0.05 1</specular>
            </material>
          </visual>
          <visual name="upper">
            <pose>0 0 6.25 0 0 0</pose>
            <geometry><box><size>${length} 0.3 7.5</size></box></geometry>
            <material>
              <ambient>0.65 0.28 0.12 1</ambient>
              <diffuse>0.65 0.28 0.12 1</diffuse>
              <specular>0.05 0.05 0.05 1</specular>
            </material>
          </visual>
          <collision name="collision">
            <pose>0 0 5.0 0 0 0</pose>
            <geometry><box><size>${length} 0.3 10.0</size></box></geometry>
          </collision>
        </link>
      </model>
    </xacro:macro>

    <!-- Roll-up dock door (4m wide x 5m tall, brick above) -->
    <xacro:macro name="dock_door" params="name x y yaw">
      <model name="door_${name}">
        <static>true</static>
        <pose>${x} ${y} 0 0 0 ${yaw}</pose>
        <link name="link">
          <visual name="door_panel">
            <pose>0 0 2.5 0 0 0</pose>
            <geometry><box><size>4.0 0.15 5.0</size></box></geometry>
            <material>
              <ambient>0.55 0.56 0.58 1</ambient>
              <diffuse>0.55 0.56 0.58 1</diffuse>
              <specular>0.4 0.4 0.4 1</specular>
            </material>
          </visual>
          <visual name="above_door">
            <pose>0 0 7.5 0 0 0</pose>
            <geometry><box><size>4.0 0.3 5.0</size></box></geometry>
            <material>
              <ambient>0.65 0.28 0.12 1</ambient>
              <diffuse>0.65 0.28 0.12 1</diffuse>
              <specular>0.05 0.05 0.05 1</specular>
            </material>
          </visual>
          <collision name="collision">
            <pose>0 0 2.5 0 0 0</pose>
            <geometry><box><size>4.0 0.15 5.0</size></box></geometry>
          </collision>
        </link>
      </model>
    </xacro:macro>

    <!-- Support column (10.0m tall) -->
    <xacro:macro name="support_column" params="name x y">
      <model name="col_${name}">
        <static>true</static>
        <pose>${x} ${y} 5.0 0 0 0</pose>
        <link name="link">
          <visual name="visual">
            <geometry><box><size>0.4 0.4 10.0</size></box></geometry>
            <material>
              <ambient>0.55 0.52 0.50 1</ambient>
              <diffuse>0.55 0.52 0.50 1</diffuse>
              <specular>0.2 0.2 0.2 1</specular>
            </material>
          </visual>
          <collision name="collision">
            <geometry><box><size>0.4 0.4 10.0</size></box></geometry>
          </collision>
        </link>
      </model>
    </xacro:macro>

    <!-- Shelf macros: ALL running E-W (long axis in X), yaw=0 -->
    <!-- shelf default: 3.5m X x 1m Y -->
    <xacro:macro name="small_shelf" params="name x y">
      <include>
        <uri>shelf</uri>
        <name>${name}</name>
        <pose>${x} ${y} 0 0 0 0</pose>
        <static>true</static>
      </include>
    </xacro:macro>

    <!-- shelf_big default: 7.5m X x 1.2m Y -->
    <xacro:macro name="big_shelf" params="name x y">
      <include>
        <uri>shelf_big</uri>
        <name>${name}</name>
        <pose>${x} ${y} 0 0 0 0</pose>
        <static>true</static>
      </include>
    </xacro:macro>

    <!-- shelf_big rotated N-S: 1.2m X x 7.5m Y -->
    <xacro:macro name="big_shelf_ns" params="name x y">
      <include>
        <uri>shelf_big</uri>
        <name>${name}</name>
        <pose>${x} ${y} 0 0 0 1.5708</pose>
        <static>true</static>
      </include>
    </xacro:macro>

    <!-- Pallet macro -->
    <xacro:macro name="pallet" params="name x y z yaw">
      <include>
        <uri>pallet_box_mobile</uri>
        <name>${name}</name>
        <pose>${x} ${y} ${z} 0 0 ${yaw}</pose>
        <static>true</static>
      </include>
    </xacro:macro>

    <!-- ============================================================ -->
    <!-- PERIMETER WALLS (120m x 140m, 10.0m tall brick) -->
    <!-- ============================================================ -->

    <xacro:wall_segment name="north" x="0" y="70.0" yaw="0" length="120"/>
    <xacro:wall_segment name="east" x="60.0" y="0" yaw="1.5708" length="140"/>
    <xacro:wall_segment name="west" x="-60.0" y="0" yaw="1.5708" length="140"/>

    <!-- South wall segments (between dock doors) -->
    <xacro:wall_segment name="south_1" x="-56.0" y="-70.0" yaw="0" length="8.0"/>
    <xacro:wall_segment name="south_2" x="-44.0" y="-70.0" yaw="0" length="8.0"/>
    <xacro:wall_segment name="south_3" x="-32.0" y="-70.0" yaw="0" length="8.0"/>
    <xacro:wall_segment name="south_4" x="-20.0" y="-70.0" yaw="0" length="8.0"/>
    <xacro:wall_segment name="south_5" x="-8.0" y="-70.0" yaw="0" length="8.0"/>
    <xacro:wall_segment name="south_6" x="4.0" y="-70.0" yaw="0" length="8.0"/>
    <xacro:wall_segment name="south_7" x="16.0" y="-70.0" yaw="0" length="8.0"/>
    <xacro:wall_segment name="south_8" x="28.0" y="-70.0" yaw="0" length="8.0"/>
    <xacro:wall_segment name="south_9" x="48.0" y="-70.0" yaw="0" length="24.0"/>

    <!-- Roll-up dock doors -->
    <xacro:dock_door name="dock1" x="-50" y="-70.0" yaw="0"/>
    <xacro:dock_door name="dock2" x="-38" y="-70.0" yaw="0"/>
    <xacro:dock_door name="dock3" x="-26" y="-70.0" yaw="0"/>
    <xacro:dock_door name="dock4" x="-14" y="-70.0" yaw="0"/>
    <xacro:dock_door name="dock5" x="-2" y="-70.0" yaw="0"/>
    <xacro:dock_door name="dock6" x="10" y="-70.0" yaw="0"/>
    <xacro:dock_door name="dock7" x="22" y="-70.0" yaw="0"/>
    <xacro:dock_door name="dock8" x="34" y="-70.0" yaw="0"/>

    <!-- ============================================================ -->
    <!-- SUPPORT COLUMNS                                               -->
    <!-- ============================================================ -->

    <xacro:support_column name="n0" x="-45" y="70.0"/>
    <xacro:support_column name="n1" x="-30" y="70.0"/>
    <xacro:support_column name="n2" x="-15" y="70.0"/>
