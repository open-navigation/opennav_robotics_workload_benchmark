    <!-- ZONE A: BULK STORAGE (big shelves, back-to-back pairs, 2.0 m aisles) -->
    <!-- 14 rows x 14 per row, aisle ~2.0m -->
    <!-- ============================================================ -->

    <xacro:big_shelf name="zone_a_r1_1" x="-54.0" y="-37.2"/>
    <xacro:big_shelf name="zone_a_r1_2" x="-46.0" y="-37.2"/>
    <xacro:big_shelf name="zone_a_r1_3" x="-38.0" y="-37.2"/>
