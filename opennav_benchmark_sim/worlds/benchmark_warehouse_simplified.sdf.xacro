<?xml version="1.0"?>
<sdf version="1.7" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="headless" default="false"/>

  <world name="benchmark_warehouse_simplified">

    <physics name="tpe" type="tpe">
      <max_step_size>0.010</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <engine>
        <filename>gz-physics-tpe-plugin</filename>
      </engine>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <xacro:unless value="$(arg headless)">
      <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    </xacro:unless>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Scene -->
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
    </scene>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.001</linear>
        <quadratic>0.0001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <!-- Ground plane (128m x 140m) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>128 140</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>128 140</size></plane></geometry>
          <material>
            <ambient>0.55 0.55 0.53 1</ambient>
            <diffuse>0.55 0.55 0.53 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- ============================================================ -->
    <!-- MACROS - SIMPLIFIED (all box primitives for real-time perf)   -->
    <!-- Locations mirror benchmark_warehouse.sdf.xacro so the         -->
    <!-- generated occupancy matches application/maps/benchmark_warehouse. -->
    <!-- ============================================================ -->

    <!-- Brick perimeter wall (10.0m tall, single box) -->
    <xacro:macro name="wall_segment" params="name x y yaw length">
      <model name="wall_${name}">
        <static>true</static>
        <pose>${x} ${y} 5.0 0 0 ${yaw}</pose>
        <link name="link">
          <visual name="visual">
            <geometry><box><size>${length} 0.3 10.0</size></box></geometry>
            <material>
              <ambient>0.60 0.25 0.10 1</ambient>
              <diffuse>0.60 0.25 0.10 1</diffuse>
              <specular>0.05 0.05 0.05 1</specular>
            </material>
          </visual>
          <collision name="collision">
            <geometry><box><size>${length} 0.3 10.0</size></box></geometry>
          </collision>
        </link>
      </model>
    </xacro:macro>

    <!-- Roll-up dock door (4m wide x 10m tall, single box) -->
    <xacro:macro name="dock_door" params="name x y yaw">
      <model name="door_${name}">
        <static>true</static>
        <pose>${x} ${y} 5.0 0 0 ${yaw}</pose>
        <link name="link">
          <visual name="visual">
            <geometry><box><size>4.0 0.15 10.0</size></box></geometry>
            <material>
              <ambient>0.55 0.56 0.58 1</ambient>
              <diffuse>0.55 0.56 0.58 1</diffuse>
              <specular>0.2 0.2 0.2 1</specular>
            </material>
          </visual>
          <collision name="collision">
            <geometry><box><size>4.0 0.15 10.0</size></box></geometry>
          </collision>
        </link>
      </model>
    </xacro:macro>

    <!-- Support column (0.4 x 0.4 x 10.0m) -->
    <xacro:macro name="support_column" params="name x y">
      <model name="col_${name}">
        <static>true</static>
        <pose>${x} ${y} 5.0 0 0 0</pose>
        <link name="link">
          <visual name="visual">
            <geometry><box><size>0.4 0.4 10.0</size></box></geometry>
            <material>
              <ambient>0.55 0.52 0.50 1</ambient>
              <diffuse>0.55 0.52 0.50 1</diffuse>
              <specular>0.2 0.2 0.2 1</specular>
            </material>
          </visual>
          <collision name="collision">
            <geometry><box><size>0.4 0.4 10.0</size></box></geometry>
          </collision>
        </link>
      </model>
    </xacro:macro>

    <!-- Small shelf: 3.5m X x 1.0m Y x 2.0m Z -->
    <xacro:macro name="small_shelf" params="name x y">
      <model name="${name}">
        <static>true</static>
        <pose>${x} ${y} 1.0 0 0 0</pose>
        <link name="link">
          <visual name="visual">
            <geometry><box><size>3.5 1.0 2.0</size></box></geometry>
            <material>
              <ambient>0.45 0.35 0.20 1</ambient>
              <diffuse>0.45 0.35 0.20 1</diffuse>
              <specular>0.1 0.1 0.1 1</specular>
            </material>
          </visual>
          <collision name="collision">
            <geometry><box><size>3.5 1.0 2.0</size></box></geometry>
          </collision>
        </link>
      </model>
    </xacro:macro>

    <!-- Big shelf E-W: 7.5m X x 1.2m Y x 2.0m Z -->
    <xacro:macro name="big_shelf" params="name x y">
      <model name="${name}">
        <static>true</static>
        <pose>${x} ${y} 1.0 0 0 0</pose>
        <link name="link">
          <visual name="visual">
            <geometry><box><size>7.5 1.2 2.0</size></box></geometry>
            <material>
              <ambient>0.40 0.30 0.18 1</ambient>
              <diffuse>0.40 0.30 0.18 1</diffuse>
              <specular>0.1 0.1 0.1 1</specular>
            </material>
          </visual>
          <collision name="collision">
            <geometry><box><size>7.5 1.2 2.0</size></box></geometry>
          </collision>
        </link>
      </model>
    </xacro:macro>

    <!-- Big shelf rotated N-S: 1.2m X x 7.5m Y x 2.0m Z -->
    <xacro:macro name="big_shelf_ns" params="name x y">
      <model name="${name}">
        <static>true</static>
        <pose>${x} ${y} 1.0 0 0 1.5708</pose>
        <link name="link">
          <visual name="visual">
            <geometry><box><size>7.5 1.2 2.0</size></box></geometry>
            <material>
              <ambient>0.40 0.30 0.18 1</ambient>
              <diffuse>0.40 0.30 0.18 1</diffuse>
              <specular>0.1 0.1 0.1 1</specular>
            </material>
          </visual>
          <collision name="collision">
            <geometry><box><size>7.5 1.2 2.0</size></box></geometry>
          </collision>
        </link>
      </model>
    </xacro:macro>

    <!-- Pallet: 1.2m X x 1.0m Y x 1.2m Z. z param = bottom of pallet -->
    <xacro:macro name="pallet" params="name x y z yaw">
      <model name="${name}">
        <static>true</static>
        <pose>${x} ${y} ${z + 0.6} 0 0 ${yaw}</pose>
        <link name="link">
          <visual name="visual">
            <geometry><box><size>1.2 1.0 1.2</size></box></geometry>
            <material>
              <ambient>0.60 0.45 0.25 1</ambient>
              <diffuse>0.60 0.45 0.25 1</diffuse>
              <specular>0.1 0.1 0.1 1</specular>
            </material>
          </visual>
          <collision name="collision">
            <geometry><box><size>1.2 1.0 1.2</size></box></geometry>
          </collision>
        </link>
      </model>
    </xacro:macro>

    <!-- Overturned pallet (tipped on side, roll=90deg) -->
    <xacro:macro name="overturned_pallet" params="name x y yaw">
      <model name="${name}">
        <static>true</static>
        <pose>${x} ${y} 0.55 1.5708 0 ${yaw}</pose>
        <link name="link">
          <visual name="visual">
            <geometry><box><size>1.2 1.0 1.2</size></box></geometry>
            <material>
              <ambient>0.60 0.45 0.25 1</ambient>
              <diffuse>0.60 0.45 0.25 1</diffuse>
              <specular>0.1 0.1 0.1 1</specular>
            </material>
          </visual>
          <collision name="collision">
            <geometry><box><size>1.2 1.0 1.2</size></box></geometry>
          </collision>
        </link>
      </model>
    </xacro:macro>

    <!-- Person: 0.5 x 0.4 x 1.75m box stand-in -->
    <xacro:macro name="person" params="name x y yaw">
      <model name="${name}">
        <static>true</static>
        <pose>${x} ${y} 0.875 0 0 ${yaw}</pose>
        <link name="link">
          <visual name="visual">
            <geometry><box><size>0.5 0.4 1.75</size></box></geometry>
            <material>
              <ambient>0.20 0.40 0.60 1</ambient>
              <diffuse>0.20 0.40 0.60 1</diffuse>
              <specular>0.1 0.1 0.1 1</specular>
            </material>
          </visual>
          <collision name="collision">
            <geometry><box><size>0.5 0.4 1.75</size></box></geometry>
          </collision>
        </link>
      </model>
    </xacro:macro>

    <!-- Charging station: 0.6 x 0.6 x 0.5m box stand-in -->
    <xacro:macro name="charging_station" params="name x y yaw">
      <model name="${name}">
        <static>true</static>
        <pose>${x} ${y} 0.25 0 0 ${yaw}</pose>
        <link name="link">
          <visual name="visual">
            <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
            <material>
              <ambient>0.15 0.15 0.15 1</ambient>
              <diffuse>0.15 0.15 0.15 1</diffuse>
              <specular>0.3 0.3 0.3 1</specular>
            </material>
          </visual>
          <collision name="collision">
            <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          </collision>
        </link>
      </model>
    </xacro:macro>

    <!-- Forklift: 2.5 x 1.2 x 2.0m box stand-in -->
    <xacro:macro name="forklift" params="name x y yaw">
      <model name="${name}">
        <static>true</static>
        <pose>${x} ${y} 1.0 0 0 ${yaw}</pose>
        <link name="link">
          <visual name="visual">
            <geometry><box><size>2.5 1.2 2.0</size></box></geometry>
            <material>
              <ambient>0.85 0.55 0.10 1</ambient>
              <diffuse>0.85 0.55 0.10 1</diffuse>
              <specular>0.1 0.1 0.1 1</specular>
            </material>
          </visual>
          <collision name="collision">
            <geometry><box><size>2.5 1.2 2.0</size></box></geometry>
          </collision>
        </link>
      </model>
    </xacro:macro>

    <!-- ============================================================ -->
    <!-- PERIMETER WALLS (128m x 140m, 10.0m tall brick) -->
    <!-- ============================================================ -->

    <xacro:wall_segment name="north" x="0" y="70.0" yaw="0" length="128"/>
    <xacro:wall_segment name="east" x="64.0" y="0" yaw="1.5708" length="140"/>
    <xacro:wall_segment name="west" x="-64.0" y="0" yaw="1.5708" length="140"/>

    <!-- South wall segments (between dock doors) -->
    <xacro:wall_segment name="south_1" x="-58.0" y="-70.0" yaw="0" length="12.0"/>
    <xacro:wall_segment name="south_2" x="-44.0" y="-70.0" yaw="0" length="8.0"/>
    <xacro:wall_segment name="south_3" x="-32.0" y="-70.0" yaw="0" length="8.0"/>
    <xacro:wall_segment name="south_4" x="-20.0" y="-70.0" yaw="0" length="8.0"/>
    <xacro:wall_segment name="south_5" x="-8.0" y="-70.0" yaw="0" length="8.0"/>
    <xacro:wall_segment name="south_6" x="4.0" y="-70.0" yaw="0" length="8.0"/>
    <xacro:wall_segment name="south_7" x="16.0" y="-70.0" yaw="0" length="8.0"/>
    <xacro:wall_segment name="south_8" x="28.0" y="-70.0" yaw="0" length="8.0"/>
    <xacro:wall_segment name="south_9" x="50.0" y="-70.0" yaw="0" length="28.0"/>

    <!-- Roll-up dock doors -->
    <xacro:dock_door name="dock1" x="-50" y="-70.0" yaw="0"/>
    <xacro:dock_door name="dock2" x="-38" y="-70.0" yaw="0"/>
    <xacro:dock_door name="dock3" x="-26" y="-70.0" yaw="0"/>
    <xacro:dock_door name="dock4" x="-14" y="-70.0" yaw="0"/>
    <xacro:dock_door name="dock5" x="-2" y="-70.0" yaw="0"/>
    <xacro:dock_door name="dock6" x="10" y="-70.0" yaw="0"/>
    <xacro:dock_door name="dock7" x="22" y="-70.0" yaw="0"/>
    <xacro:dock_door name="dock8" x="34" y="-70.0" yaw="0"/>

    <!-- ============================================================ -->
    <!-- SUPPORT COLUMNS                                               -->
    <!-- ============================================================ -->

    <xacro:support_column name="n0" x="-45" y="70.0"/>
    <xacro:support_column name="n1" x="-30" y="70.0"/>
    <xacro:support_column name="n2" x="-15" y="70.0"/>
    <xacro:support_column name="n3" x="0" y="70.0"/>
    <xacro:support_column name="n4" x="15" y="70.0"/>
    <xacro:support_column name="n5" x="30" y="70.0"/>
    <xacro:support_column name="n6" x="45" y="70.0"/>
    <xacro:support_column name="s7" x="-56" y="-70.0"/>
    <xacro:support_column name="s8" x="-44" y="-70.0"/>
    <xacro:support_column name="s9" x="-32" y="-70.0"/>
    <xacro:support_column name="s10" x="-20" y="-70.0"/>
    <xacro:support_column name="s11" x="-8" y="-70.0"/>
    <xacro:support_column name="s12" x="4" y="-70.0"/>
    <xacro:support_column name="s13" x="16" y="-70.0"/>
    <xacro:support_column name="e14" x="64.0" y="-60"/>
    <xacro:support_column name="e15" x="64.0" y="-40"/>
    <xacro:support_column name="e16" x="64.0" y="-20"/>
    <xacro:support_column name="e17" x="64.0" y="0"/>
    <xacro:support_column name="e18" x="64.0" y="20"/>
    <xacro:support_column name="e19" x="64.0" y="40"/>
    <xacro:support_column name="e20" x="64.0" y="60"/>
    <xacro:support_column name="w21" x="-64.0" y="-60"/>
    <xacro:support_column name="w22" x="-64.0" y="-40"/>
    <xacro:support_column name="w23" x="-64.0" y="-20"/>
    <xacro:support_column name="w24" x="-64.0" y="0"/>
    <xacro:support_column name="w25" x="-64.0" y="20"/>
    <xacro:support_column name="w26" x="-64.0" y="40"/>
    <xacro:support_column name="w27" x="-64.0" y="60"/>
    <xacro:support_column name="int_28" x="-38.0" y="-40"/>
    <xacro:support_column name="int_29" x="-38.0" y="-23"/>
    <xacro:support_column name="int_30" x="-38.0" y="15"/>
    <xacro:support_column name="int_31" x="-38.0" y="40"/>
    <xacro:support_column name="int_32" x="-18.0" y="-40"/>
    <xacro:support_column name="int_33" x="-18.0" y="-23"/>
    <xacro:support_column name="int_34" x="-18.0" y="15"/>
    <xacro:support_column name="int_35" x="-18.0" y="40"/>
    <xacro:support_column name="int_36" x="22.0" y="-40"/>
    <xacro:support_column name="int_37" x="22.0" y="-23"/>
    <xacro:support_column name="int_38" x="22.0" y="15"/>
    <xacro:support_column name="int_39" x="22.0" y="40"/>
    <xacro:support_column name="int_40" x="42.0" y="-40"/>
    <xacro:support_column name="int_41" x="42.0" y="-23"/>
    <xacro:support_column name="int_42" x="42.0" y="15"/>

    <!-- ============================================================ -->
    <!-- SHELF VOLUMES - DERIVED FROM application/maps/benchmark_warehouse -->
    <!-- 36 boxes extracted from the map's connected components, NOT the  -->
    <!-- original per-shelf xacro positions: the original mesh's long axis -->
    <!-- is in Y for big_shelf and yields one continuous 2.2 m x 72.5 m N-S -->
    <!-- wall per shelf x-position. Box footprints, orientations, and gaps -->
    <!-- now match the map exactly.                                       -->
    <!--   14 big N-S vertical walls (zones A + B-west)                   -->
    <!--    4 big E-W horizontal walls (zone D)                           -->
    <!--   18 small E-W row-segments (zone B-east: 6, zone C: 12 with     -->
    <!--      cross-aisle split)                                          -->
    <!-- ============================================================ -->

    <!-- Big N-S vertical shelves (zones A + B-west: 14 walls @ ~2.2m x 72.5m / 47.7m x 6m) -->
    <model name="shelf_ns_01">
      <static>true</static>
      <pose>-54.525 -10.025 3.000 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.200 72.500 6.000</size></box></geometry>
          <material>
            <ambient>0.40 0.30 0.18 1</ambient>
            <diffuse>0.40 0.30 0.18 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>2.200 72.500 6.000</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="shelf_ns_02">
      <static>true</static>
      <pose>-46.525 -10.025 3.000 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.200 72.500 6.000</size></box></geometry>
          <material>
            <ambient>0.40 0.30 0.18 1</ambient>
            <diffuse>0.40 0.30 0.18 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>2.200 72.500 6.000</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="shelf_ns_03">
      <static>true</static>
      <pose>-38.525 -10.025 3.000 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.200 72.500 6.000</size></box></geometry>
          <material>
            <ambient>0.40 0.30 0.18 1</ambient>
            <diffuse>0.40 0.30 0.18 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>2.200 72.500 6.000</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="shelf_ns_04">
      <static>true</static>
      <pose>-30.525 -10.025 3.000 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.200 72.500 6.000</size></box></geometry>
          <material>
            <ambient>0.40 0.30 0.18 1</ambient>
            <diffuse>0.40 0.30 0.18 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>2.200 72.500 6.000</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="shelf_ns_05">
      <static>true</static>
      <pose>-22.525 -10.025 3.000 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.200 72.500 6.000</size></box></geometry>
          <material>
            <ambient>0.40 0.30 0.18 1</ambient>
            <diffuse>0.40 0.30 0.18 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>2.200 72.500 6.000</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="shelf_ns_06">
      <static>true</static>
      <pose>-14.525 -10.025 3.000 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.200 72.500 6.000</size></box></geometry>
          <material>
            <ambient>0.40 0.30 0.18 1</ambient>
            <diffuse>0.40 0.30 0.18 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>2.200 72.500 6.000</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="shelf_ns_07">
      <static>true</static>
      <pose>-6.525 -10.025 3.000 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.200 72.500 6.000</size></box></geometry>
          <material>
            <ambient>0.40 0.30 0.18 1</ambient>
            <diffuse>0.40 0.30 0.18 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>2.200 72.500 6.000</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="shelf_ns_08">
      <static>true</static>
      <pose>9.475 -22.425 3.000 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.200 47.700 6.000</size></box></geometry>
          <material>
            <ambient>0.40 0.30 0.18 1</ambient>
            <diffuse>0.40 0.30 0.18 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>2.200 47.700 6.000</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="shelf_ns_09">
      <static>true</static>
      <pose>17.475 -22.425 3.000 0 0 0</pose>
      <link name="link">
        <visual name="visual">
